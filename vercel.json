{
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)\\.(css|js|png|jpg|jpeg|svg|ico|json|map)", "dest": "/$1.$2" },
    { "src": "(/.*)", "dest": "/index.html" }
  ]
}
